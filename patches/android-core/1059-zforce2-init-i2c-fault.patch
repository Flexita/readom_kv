+static void zforce_note_i2c_fault(u32 code, int xfer_ret, u32 len_exp, u32 len_got)
+{
+	zforce_i2c_fault_last = code;
+	if (!zforce_i2c_fault_first)
+		zforce_i2c_fault_first = code;
+	zforce_i2c_fault_count++;
+	if (code == 1)
+		zforce_i2c_fault_n1++;
+	else if (code == 2)
+		zforce_i2c_fault_n2++;
+	else if (code == 3)
+		zforce_i2c_fault_n3++;
+	zforce_i2c_last_xfer_ret = xfer_ret;
+	zforce_i2c_last_len_exp = len_exp;
+	zforce_i2c_last_len_got = len_got;
+	zforce_i2c_fault_cleared = 0;
+}
