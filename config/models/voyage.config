# Kindle Voyage (7th generation), stock firmware 5.13.6.
# Source-level only. boot/profiles/voyage-5.13.6.json is not installable, and
# this fragment is not a handoff plan: it does not name a RAM base, a partition
# or a stock-kernel function hash.
#
# imx60_wario_defconfig in the Voyage GPL member (sha256 a66a58b8…5144b0)
# sets CONFIG_VMSPLIT_3G and CONFIG_PAGE_OFFSET=0xC0000000, so the mmap
# randomisation ceiling is 16. The same file sets CONFIG_ATH6KL=m and
# CONFIG_ATH6KL_SDIO=m, so patch 0310's firmware policy applies to this chip.
# Neither line is copied from config/models/pw3.config; that file's
# LOCALVERSION must not be reused or the modules would be loaded as PW3's.

CONFIG_ARCH_MMAP_RND_BITS=16

CONFIG_LAB126_ANDROID_ATH6KL_FIRMWARE=y

CONFIG_LOCALVERSION="-lab126-voyage-android81"
