# The generic AOSP rules already create Binder, ashmem, graphics and input nodes.
# Use device names, not unstable event0/event1 assignments.
/dev/graphics/fb0 0660 system graphics
/dev/rtc* 0640 system system

# AOSP8.1 MatchWithSubsystem resolves these class aliases against real uevents.
/sys/class/backlight/max77696-bl brightness 0660 system system
/sys/class/backlight/max77696-bl bl_power 0660 system system

# Voyage PagePress / ALS misc nodes (absent on PW3 until modules load).
/dev/keypad 0660 system system
/dev/als 0660 system system

# No raw block-device permission grants and no touch-firmware loader node.
