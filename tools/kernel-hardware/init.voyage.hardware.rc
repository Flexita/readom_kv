# Voyage (icewine_wario) public modules — t172u Cypress correction.
# Hardware: iFixit Voyage teardown names Cypress CY8CTMA4; GPL board table
# registers cyttsp4_i2c_adapter @ 0x24 (and a parallel zforce2 @ 0x50 that is
# NOT the stock input path). Stock icewine logs expose input name "cyttsp4_mt".
# Load Cypress TTSP4 only for touch. Keep PagePress (fsr_keypad) + DRV26xx
# haptics as separate modules — not touch evidence. Do not load zforce2.
# CONFIG_LAB126_ANDROID_DISABLE_TOUCH_FW_UPDATE rejects the cyttsp loader.
# Not a device boot proof. Per-device firmware under /firmware/image stays
# root-only DAC; this RC does not flash firmware.

on post-fs-data
    insmod /vendor/lib/modules/drv26xx_haptics.ko
    insmod /vendor/lib/modules/fsr_keypad.ko
    insmod /vendor/lib/modules/cyttsp4_core.ko recovery_mode=0
    insmod /vendor/lib/modules/cyttsp4_i2c.ko
    insmod /vendor/lib/modules/cyttsp4_mt_b.ko
    insmod /vendor/lib/modules/cfg80211.ko
    chown system system /sys/class/backlight/max77696-bl/brightness
    chmod 0660 /sys/class/backlight/max77696-bl/brightness
    chown system system /sys/class/backlight/max77696-bl/bl_power
    chmod 0660 /sys/class/backlight/max77696-bl/bl_power

# The Wi-Fi stack must request these states; no automatic radio-on at boot.
on property:vendor.pw3.wifi.modules=load
    insmod /vendor/lib/modules/ath6kl_sdio.ko board_data_file=ath6k/AR6003/hw2.1.1/board.bin suspend_mode=1 wow_mode=0 recovery_enable=1

on property:vendor.pw3.wifi.modules=unload
    rmmod ath6kl_sdio
